{
  "name": "mwi-build-optimizer",
  "version": "0.1.0",
  "description": "Multi-build / multi-user MWI combat efficiency optimizer (forked from shykai/MWICombatSimulatorTest@feature-json).",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch",
    "start": "webpack serve --mode development --open",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "heap-js": "^2.2.0"
  },
  "build": {
    "appId": "io.github.mwiBuildOptimizer",
    "productName": "MWI 配装效率优化器",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
